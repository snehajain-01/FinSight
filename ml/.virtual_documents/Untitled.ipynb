        )
    )


import json
import pandas as pd

data = []

for messages in df["messages"]:

    user_message = None
    assistant_message = None

    for message in messages:
        if message["role"] == "user":
            user_message = message["content"]

        elif message["role"] == "assistant":
            assistant_message = message["content"]

    if user_message and assistant_message:

        try:
            # The actual transaction comes after the blank line
            parts = user_message.split("\n\n", 1)

            if len(parts) == 2:
                transaction_text = parts[1].strip()
            else:
                transaction_text = user_message.strip()

            # Convert assistant response from JSON string to dictionary
            result = json.loads(assistant_message)

            category = result.get("category")

            data.append({
                "transaction": transaction_text,
                "category": category
            })

        except (json.JSONDecodeError, TypeError):
            pass

ml_df = pd.DataFrame(data)

print("Total records:", len(ml_df))
print("\nMissing categories:")
print(ml_df["category"].isna().sum())

display(ml_df.head(10))


ml_df = ml_df.dropna(subset=["category"]).copy()

print("Records available for ML:", len(ml_df))


print(ml_df["category"].value_counts())


for category in ["food", "shopping", "travel", "bills", "healthcare"]:
    
    print("\n==========", category.upper(), "==========")
    
    display(
        ml_df[ml_df["category"] == category][
            ["transaction", "category"]
        ].sample(
            min(5, len(ml_df[ml_df["category"] == category])),
            random_state=42
        )
    )


print(ml_df.shape)


print(ml_df["category"].value_counts())


display(ml_df.sample(20, random_state=42))


import re

def clean_transaction(text):
    text = str(text).lower()

    # Replace account numbers such as XX9806
    text = re.sub(r'\bxx\d+\b', ' ', text)

    # Remove amounts
    text = re.sub(r'rs\.?\s*[\d,]+(?:\.\d+)?', ' ', text)
    text = re.sub(r'inr\s*[\d,]+(?:\.\d+)?', ' ', text)

    # Remove remaining standalone numbers
    text = re.sub(r'\b\d+(?:\.\d+)?\b', ' ', text)

    # Remove punctuation
    text = re.sub(r'[^\w\s]', ' ', text)

    # Remove extra spaces
    text = re.sub(r'\s+', ' ', text).strip()

    return text

ml_df["clean_transaction"] = ml_df["transaction"].apply(clean_transaction)

display(
    ml_df[["transaction", "clean_transaction", "category"]].head(20)
)


display(
    ml_df.sample(20, random_state=42)[
        ["transaction", "clean_transaction", "category"]
    ]
)








from sklearn.model_selection import train_test_split

X = ml_df["clean_transaction"]
y = ml_df["category"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training samples:", len(X_train))
print("Testing samples:", len(X_test))


#TF-IDF
from sklearn.feature_extraction.text import TfidfVectorizer

tfidf = TfidfVectorizer(
    max_features=10000,
    ngram_range=(1, 2),
    min_df=2,
    sublinear_tf=True
)

X_train_tfidf = tfidf.fit_transform(X_train)
X_test_tfidf = tfidf.transform(X_test)

print("Training shape:", X_train_tfidf.shape)
print("Testing shape:", X_test_tfidf.shape)


from sklearn.linear_model import LogisticRegression

model_lr = LogisticRegression(
    max_iter=1000,
    class_weight="balanced"
)

model_lr.fit(X_train_tfidf, y_train)

print("Logistic Regression training completed!")


y_pred_lr = model_lr.predict(X_test_tfidf)

print(y_pred_lr[:20])


from sklearn.metrics import accuracy_score, classification_report

accuracy = accuracy_score(y_test, y_pred_lr)

print("Accuracy:", accuracy)

print("\nClassification Report:")
print(classification_report(y_test, y_pred_lr))





from sklearn.svm import LinearSVC

model_svm = LinearSVC(
    class_weight="balanced",
    random_state=42
)

model_svm.fit(X_train_tfidf, y_train)

print("Linear SVM training completed!")


y_pred_svm = model_svm.predict(X_test_tfidf)

print(y_pred_svm[:20])


from sklearn.metrics import accuracy_score, classification_report

accuracy_svm = accuracy_score(y_test, y_pred_svm)

print("SVM Accuracy:", accuracy_svm)

print("\nSVM Classification Report:")
print(classification_report(y_test, y_pred_svm))





from sklearn.naive_bayes import MultinomialNB

model_nb = MultinomialNB()

model_nb.fit(X_train_tfidf, y_train)

print("Naive Bayes training completed!")


y_pred_nb = model_nb.predict(X_test_tfidf)

print(y_pred_nb[:20])


from sklearn.metrics import accuracy_score, classification_report

accuracy_nb = accuracy_score(y_test, y_pred_nb)

print("Naive Bayes Accuracy:", accuracy_nb)

print("\nNaive Bayes Classification Report:")
print(classification_report(y_test, y_pred_nb))


from sklearn.metrics import f1_score

f1_lr = f1_score(y_test, y_pred_lr, average="macro")
f1_svm = f1_score(y_test, y_pred_svm, average="macro")
f1_nb = f1_score(y_test, y_pred_nb, average="macro")

comparison = pd.DataFrame({
    "Model": [
        "Logistic Regression",
        "Linear SVM",
        "Naive Bayes"
    ],
    "Accuracy": [
        accuracy,
        accuracy_svm,
        accuracy_nb
    ],
    "Macro F1": [
        f1_lr,
        f1_svm,
        f1_nb
    ]
})

display(comparison)





#testing with new transactions
new_transactions = [
    "Rs.650 spent at Swiggy",
    "Rs.1299 spent at Amazon",
    "Rs.450 paid to Uber",
    "Rs.899 paid at Apollo Pharmacy",
    "Rs.799 charged by Netflix",
    "Rs.5000 invested through Zerodha"
]


new_clean = [clean_transaction(x) for x in new_transactions]


new_tfidf = tfidf.transform(new_clean)


predictions = model_svm.predict(new_tfidf)

for transaction, prediction in zip(new_transactions, predictions):
    print(f"{transaction}  -->  {prediction}")


decision_scores = model_svm.decision_function(new_tfidf)

for transaction, prediction, scores in zip(
    new_transactions,
    predictions,
    decision_scores
):
    confidence = scores.max()
    
    print(f"\nTransaction: {transaction}")
    print(f"Prediction : {prediction}")
    print(f"Score      : {confidence:.3f}")



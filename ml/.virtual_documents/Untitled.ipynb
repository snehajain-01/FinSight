import re

def clean_text(text):
    text = str(text).lower()
    
    # Remove numbers
    text = re.sub(r'\d+', ' ', text)
    
    # Remove special characters
    text = re.sub(r'[^a-zA-Z\s]', ' ', text)
    
    # Remove extra spaces
    text = re.sub(r'\s+', ' ', text).strip()
    
    return text

ml_df["clean_transaction"] = ml_df["transaction"].apply(clean_text)

display(
    ml_df[["transaction", "clean_transaction", "category"]].head(10)
)


